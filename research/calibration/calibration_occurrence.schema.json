{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arjo.local/schemas/calibration_occurrence.schema.json",
  "title": "Arjo calibration semantic-anchor occurrence packet",
  "type": "object",
  "required": [
    "schema_version",
    "occurrence_id",
    "direction",
    "provider_identity",
    "request_contract_sha256",
    "calibration_data_refs",
    "annotations",
    "consensus_anchors_sha256",
    "observations"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "occurrence_id": {"type": "string", "minLength": 1},
    "direction": {"const": "LONG"},
    "provider_identity": {
      "type": "object",
      "required": ["provider", "venue", "environment", "instrument", "instrument_identity"],
      "properties": {
        "provider": {"const": "OANDA_V20"},
        "venue": {"const": "OANDA_FXTRADE"},
        "environment": {"const": "practice"},
        "instrument": {"const": "NAS100_USD"},
        "instrument_identity": {"const": "OANDA_NASDAQ100_CFD_PROXY_FOR_LOCKED_NQ_SEED"}
      },
      "additionalProperties": false
    },
    "request_contract_sha256": {"const": "8923d63d27df107fd422b9bab97490c8403d656ffb9c3577cc3e4f67474c4a51"},
    "calibration_data_refs": {"type": "array", "minItems": 1},
    "annotations": {"type": "array", "minItems": 2, "maxItems": 2},
    "consensus_anchors_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "observations": {"type": "object"}
  },
  "additionalProperties": false
}
